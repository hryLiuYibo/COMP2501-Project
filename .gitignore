# ---------- OS ----------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.Trash-*/

# ---------- Editors / IDEs ----------
# Vim
*.swp
*.swo
*~

# VS Code
.vscode/

# JetBrains (IntelliJ, CLion, PyCharm, etc.)
.idea/
*.iml
*.iws
*.ipr

# ---------- Obsidian vault ----------
# Personal notes vault is kept out of the project repo entirely.
.obsidian/

# ---------- R session artifacts ----------
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
.Renviron
*.utf8.md
*.knit.md
Rplots.pdf
Rplots.png

# knitr / R Markdown intermediate cache
*.R
!R/*.R
!R/**/*.R
.cache/
/*_cache/
/*_files/

# R package build artifacts (only relevant if we ever build a local pkg)
src/*.o
src/*.so
src/*.dll

# ---------- Common build / language artifacts ----------
# C / C++ object files / binaries
*.o
*.obj
*.out
*.app

# Java / Kotlin / Gradle
*.class
*.jar
target/
.gradle/
build/

# ---------- Misc ----------
*.tmp
*.bak
*.swp
*.log

# ---------- Project: music pipeline (audio stays OUT of git) ----------
data/ncm/
data/mp3/
data/raw/weekly_top100/

# Audio preprocessing caches (never commit audio in any format)
*.wav
*.flac
*.m4a
*.aac
*.ogg
*.mp3
*.ncm
*.lrc

# Model weights / embedding-model caches (no Python embedder in this project
# anymore, but keep the rule in case a future contributor adds one)
data/embeddings/weights/
data/embeddings/cache/
*.onnx
*.pt
*.pth
*.bin
*.h5

# Native helper binaries (ncmdump.exe, etc.). We do NOT commit the decoder.
# Put ncmdump.exe somewhere outside the repo (e.g. ~/tools/ncmdump.exe) and
# point the converter at it with --exe.
*.exe
!tools/.gitkeep

# ---------- Allow-list ----------
# A handful of small derived artifacts MUST be committed even though their
# parent directories are ignored. Keep these explicit so we never accidentally
# commit an audio file via a typo.
!data/embeddings/song_features.csv
!data/embeddings/song_features_failures.csv
!data/embeddings/all_snapshots.rds
!data/songs_catalog.json
